#!/usr/bin/env bash
# clean.sh — Amar's Arch cleanup script

set -euo pipefail

BOLD='\033[1m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

confirm() {
    read -rp "$(echo -e "${YELLOW}$1 [y/N]: ${NC}")" ans
    [[ "$ans" =~ ^[Yy]$ ]]
}

section() {
    echo -e "\n${BOLD}==> $1${NC}"
}

# ── Trash ──────────────────────────────────────────────────────────────────
section "Trash"
size=$(du -sh ~/.local/share/Trash/ 2>/dev/null | cut -f1)
if confirm "Empty Trash ($size)?"; then
    rm -rf ~/.local/share/Trash/*
    echo -e "${GREEN}✓ Trash cleared${NC}"
fi

# ── Pacman cache ───────────────────────────────────────────────────────────
section "Pacman cache"
size=$(sudo du -sh /var/cache/pacman/pkg/ 2>/dev/null | cut -f1)
if confirm "Run paccache -rk1 ($size)?"; then
    sudo pacman -S --needed --noconfirm pacman-contrib &>/dev/null
    sudo paccache -rk1
    sudo rm -rf /var/cache/pacman/pkg/download-*/
    echo -e "${GREEN}✓ Pacman cache trimmed${NC}"
fi

# ── AUR caches ─────────────────────────────────────────────────────────────
section "AUR build caches (paru + yay)"
if confirm "Clear paru/yay caches?"; then
    rm -rf ~/.cache/paru/* ~/.cache/yay/*
    echo -e "${GREEN}✓ AUR caches cleared${NC}"
fi

# ── Orphaned packages ──────────────────────────────────────────────────────
section "Orphaned packages"
orphans=$(pacman -Qtdq 2>/dev/null)
if [[ -n "$orphans" ]]; then
    echo "$orphans"
    if confirm "Remove orphans?"; then
        echo "$orphans" | sudo pacman -Rns -
        echo -e "${GREEN}✓ Orphans removed${NC}"
    fi
else
    echo "No orphans found."
fi

# ── Journal ────────────────────────────────────────────────────────────────
section "Journal logs"
size=$(journalctl --disk-usage 2>/dev/null | grep -oP '[\d.]+ [A-Z]+')
if confirm "Vacuum journal to 200M (currently $size)?"; then
    sudo journalctl --vacuum-size=200M
    echo -e "${GREEN}✓ Journal vacuumed${NC}"
fi

# ── ~/.cache junk ──────────────────────────────────────────────────────────
section "Cache directories"

declare -A caches=(
    ["Brave browser cache"]="$HOME/.cache/BraveSoftware"
    ["pip cache"]="$HOME/.cache/pip"
    ["jedi cache"]="$HOME/.cache/jedi"
    ["drkonqi (KDE crash reporter)"]="$HOME/.cache/drkonqi"
    ["electron cache"]="$HOME/.cache/electron"
    ["thumbnails"]="$HOME/.cache/thumbnails"
    ["wine cache"]="$HOME/.cache/wine"
    ["winetricks cache"]="$HOME/.cache/winetricks"
    ["Nuitka cache"]="$HOME/.cache/Nuitka"
    ["go-build cache"]="$HOME/.cache/go-build"
    ["neo compiler cache"]="$HOME/.cache/neo_compiler_cache"
)

for label in "${!caches[@]}"; do
    path="${caches[$label]}"
    [[ -d "$path" ]] || continue
    size=$(du -sh "$path" 2>/dev/null | cut -f1)
    if confirm "Clear $label ($size)?"; then
        rm -rf "${path:?}"/*
        echo -e "${GREEN}✓ Cleared $label${NC}"
    fi
done

# ── Done ───────────────────────────────────────────────────────────────────
echo -e "\n${GREEN}${BOLD}All done. Run 'df -h /' to see current usage.${NC}"

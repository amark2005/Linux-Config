#!/usr/bin/env zsh
# clean.sh — Fedora GNOME cleanup script (zsh)
set -euo pipefail

BOLD='\033[1m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

# ── Sudo keepalive ─────────────────────────────────────────────────────────
sudo -v
while true; do sudo -n true; sleep 60; kill -0 "$$" || exit; done 2>/dev/null &

confirm() {
    read "ans?$(echo -e "${YELLOW}$1 [y/N]: ${NC}")"
    [[ "$ans" =~ ^[Yy]$ ]]
}

section() {
    echo -e "\n${BOLD}==> $1${NC}"
}

# ── Trash ──────────────────────────────────────────────────────────────────
section "Trash"
size=$(sudo du -sh /var/cache/dnf/ 2>/dev/null | cut -f1) || size="unknown"
if confirm "Empty Trash ($size)?"; then
    rm -rf ~/.local/share/Trash/files/* ~/.local/share/Trash/info/*
    echo -e "${GREEN}✓ Trash cleared${NC}"
fi

# ── DNF cache ──────────────────────────────────────────────────────────────
section "DNF cache"
size=$(sudo du -sh /var/cache/dnf/ 2>/dev/null | cut -f1)
if confirm "Clean DNF cache ($size)?"; then
    sudo dnf clean all
    echo -e "${GREEN}✓ DNF cache cleaned${NC}"
fi

# ── Orphaned / leftover packages ──────────────────────────────────────────
section "Unneeded dependencies"
orphans=$(dnf repoquery --unneeded -q 2>/dev/null)
if [[ -n "$orphans" ]]; then
    echo "$orphans"
    if confirm "Remove unneeded packages?"; then
        sudo dnf autoremove -y
        echo -e "${GREEN}✓ Unneeded packages removed${NC}"
    fi
else
    echo "No unneeded packages found."
fi

# ── Old kernels ────────────────────────────────────────────────────────────
section "Old kernels"
kcount=$(dnf repoquery --installonly -q | wc -l)
if (( kcount > 2 )); then
    echo "Installed kernels: $kcount (keeping latest 2 is typical)"
    if confirm "Remove old kernels (keep latest 2)?"; then
        sudo dnf remove -y --oldinstallonly --setopt installonly_limit=2 kernel
        echo -e "${GREEN}✓ Old kernels removed${NC}"
    fi
else
    echo "Only $kcount kernel(s) installed, nothing to trim."
fi

# ── Flatpak ────────────────────────────────────────────────────────────────
section "Flatpak"
if command -v flatpak &>/dev/null; then
    unused=$(flatpak uninstall --unused --noninteractive --assumeyes --dry-run 2>/dev/null || true)
    if confirm "Remove unused Flatpak runtimes?"; then
        flatpak uninstall --unused -y
        echo -e "${GREEN}✓ Unused Flatpak runtimes removed${NC}"
    fi
    if confirm "Clear Flatpak repo cache?"; then
        rm -rf ~/.var/app/*/cache/*
        echo -e "${GREEN}✓ Flatpak app caches cleared${NC}"
    fi
fi

# ── journal ────────────────────────────────────────────────────────────────
section "Journal logs"
size=$(journalctl --disk-usage 2>/dev/null | grep -oP '[\d.]+ [A-Z]+')
if confirm "Vacuum journal to 200M (currently $size)?"; then
    sudo journalctl --vacuum-size=200M
    echo -e "${GREEN}✓ Journal vacuumed${NC}"
fi

# ── GNOME thumbnail cache ─────────────────────────────────────────────────
section "GNOME thumbnail cache"
path="$HOME/.cache/thumbnails"
if [[ -d "$path" ]]; then
    size=$(du -sh "$path" 2>/dev/null | cut -f1)
    if confirm "Clear GNOME thumbnail cache ($size)?"; then
        rm -rf "${path:?}"/*
        echo -e "${GREEN}✓ Thumbnail cache cleared${NC}"
    fi
fi

# ── ~/.cache junk ──────────────────────────────────────────────────────────
section "Cache directories"
typeset -A caches=(
    ["Brave browser cache"]="$HOME/.cache/BraveSoftware"
    ["Firefox cache"]="$HOME/.cache/mozilla"
    ["pip cache"]="$HOME/.cache/pip"
    ["jedi cache"]="$HOME/.cache/jedi"
    ["electron cache"]="$HOME/.cache/electron"
    ["wine cache"]="$HOME/.cache/wine"
    ["winetricks cache"]="$HOME/.cache/winetricks"
    ["go-build cache"]="$HOME/.cache/go-build"
)
for label path in "${(@kv)caches}"; do
    [[ -d "$path" ]] || continue
    size=$(du -sh "$path" 2>/dev/null | cut -f1)
    if confirm "Clear $label ($size)?"; then
        rm -rf "${path:?}"/*
        echo -e "${GREEN}✓ Cleared $label${NC}"
    fi
done

# ── Done ───────────────────────────────────────────────────────────────────
echo -e "\n${GREEN}${BOLD}All done. Run 'df -h /' to see current usage.${NC}"
